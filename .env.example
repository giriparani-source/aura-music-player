# ==============================================================================
# Aura Music Player — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local environment.
# In production (Render, Railway, VPS), configure these in your provider's dashboard.
# NEVER commit your actual .env file or real secrets to Git.

# --- Server & Networking ---
PORT=3000

# --- Frontend Vercel Production Environment (Optional) ---
# When deployed to Vercel (https://aura-music-player-omega.vercel.app/), relative '/api' is used by default.
# If hosting the frontend on a separate domain from the serverless API, specify the base URL here:
# VITE_API_BASE_URL=https://aura-music-player-omega.vercel.app
# VITE_JIOSAAVN_API_URL=https://jiosaavn-api-sage.vercel.app

# --- Music Storage Provider ---
# Options: 'local' (development filesystem) | 'r2' (Cloudflare R2) | 's3' (AWS S3)
STORAGE_PROVIDER=local

# --- Local Storage Configuration (Used when STORAGE_PROVIDER=local) ---
MUSIC_DIR=G:\My Drive\songs 1

# --- Cloudflare R2 Configuration (Used when STORAGE_PROVIDER=r2) ---
# Note: R2 provides 10GB free tier and $0 egress bandwidth fees (subject to Cloudflare verification)
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=aura-music-storage

# --- AWS S3 Configuration (Used when STORAGE_PROVIDER=s3) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_S3_BUCKET_NAME=your_s3_bucket_name_here
